# ===========================================
# Configuración de Producción - SISGE
# ===========================================
# Copiar este archivo a .env y completar los valores

# ===========================================
# BASE DE DATOS ORACLE
# ===========================================
ConnectionStrings__Oracle=Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=tu-servidor-oracle)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=tu-servicio)));User Id=tu-usuario;Password=tu-contraseña;"

# ===========================================
# JWT - Autenticación
# ===========================================
# IMPORTANTE: Cambiar esta clave en producción!
Jwt__Key=YourSuperSecretKeyAtLeast32CharactersLong!
Jwt__Issuer=oftic.api
Jwt__Audience=oftic.api

# ===========================================
# ALMACENAMIENTO
# ===========================================
Storage__SliderPath=/app/uploads/sliders
Storage__RadioLogoPath=/app/uploads/radio

# ===========================================
# API EXTERNA PIP (Token)
# ===========================================
PipBaseUrl=https://internalpip.policia.gov.co:8080
PipClientId=tu-client-id
PipClientSecret=tu-client-secret

# ===========================================
# PUERTOS
# ===========================================
# API: 5000
# Frontend: 80
