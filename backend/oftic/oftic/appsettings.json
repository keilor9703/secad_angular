{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "MasterDb": "Host=localhost;Port=5433;Database=secad;Username=postgres;Password=postgres"
  },

  "ApiSettings": {
    "UsuarioPip": "USRSW.NEWUPD",
    "ClavePip": "HWV9Dq8N!*_X%zU%juz*",
    "PostPipToken": "https://internalpip.policia.gov.co:8080/api/Cuenta/Token",
    "OudLogin": "https://internalpip.policia.gov.co:8080/api/Oud/LoginOud",
    "ConsultaFuncionarios": "https://internalpip.policia.gov.co:8080/api/Icahu/FuncionarioPorIdentificacion?_identificacion=",
    "TokenCacheMinutes": 25,
    "SecadBaseUrl": "https://secad.policia.gov.co"
  },

  "Auth": {
    "ValidateOudInDevelopment": false,
    "DevTenantCodDane": "11001"
  },

  // ── Doble Factor de Autenticación (MFA / 2FA) ─────────────────────────────────
  // Integración con el servicio centralizado Api2FA de la Policía Nacional.
  //
  // Enabled: true → activa el 2FA en el login para usuarios OUD (funcionarios).
  //          false → desactiva completamente (desarrollo / entornos sin Api2FA).
  //
  // ApiBaseUrl: URL base del Api2FA institucional.
  //
  // Sistema: nombre del sistema registrado en Api2FA (debe coincidir con
  //          el key en SistemasConfiables del Api2FA).
  //
  // HmacSecret: secreto compartido para firmar las peticiones TokenSistema.
  //             CAMBIAR en producción — debe coincidir con el valor en Api2FA:
  //             appsettings.json → SistemasConfiables:SECAD
  //
  // AllowLoginOnServiceDown: true → permite login sin 2FA si Api2FA está caído.
  //                          false (recomendado) → bloquea el login hasta que
  //                          el servicio se restablezca.
  "Mfa": {
    "Enabled": false,
    "ApiBaseUrl": "https://localhost:44382",
    "Sistema": "SECAD",
    "HmacSecret": "SECRET_HMAC_SECAD_CAMBIAR_EN_PRODUCCION",
    "AllowLoginOnServiceDown": false
  },

  "Menu": {
    "SuperUserIds": "1,2"
  },

  "Jwt": {
    "Key": "CAMBIAR_EN_PRODUCCION_ClaveSeguraMinimo32Caracteres_2026",
    "Issuer": "secad.api",
    "Audience": "secad.api",
    "Minutes": "480"
  },

  "Storage": {
    "LoginBackgroundsPath": "uploads/login",
    "VideoPath": "uploads/videos"
  },

  "AppSettings": {
    "UploadsPath": "/opt/secad/uploads"
  },

  // ── Recepción multicanal — Chat y SMS API REST ──────────────────────────────
  // Clave que los sistemas externos deben enviar en la cabecera X-Api-Key.
  // CAMBIAR obligatoriamente en producción. Mínimo 32 caracteres aleatorios.
  "RecepcionExterna": {
    "ApiKey": "CAMBIAR_ESTA_CLAVE_EN_PRODUCCION_MinMax32Chars_2026"
  },

  "Snowflake": {
    // NodeId identifica físicamente este nodo en el clúster.
    // Nodo Principal (Main DB)  → 1
    // Nodo Edge (réplica local) → 2
    // Rango válido: 0 – 1023. NUNCA repitas el mismo NodeId en dos nodos activos
    // simultáneamente o se generarán colisiones de IDs al hacer el merge.
    "NodeId": 1
  },

  // ── Monitor de salud de CADs ────────────────────────────────────────────────
  // El BackgroundService CadHealthMonitorService sondea periódicamente la BD de
  // cada CAD registrado en secad_tenants y actualiza los campos de salud.
  //
  // Niveles de operación:
  //   1 = Normal    (conexión OK, latencia < DegradedLatencyMs)
  //   2 = Degradado (conexión OK, latencia >= DegradedLatencyMs)
  //   3 = Offline   (fallo de conexión >= OfflineThreshold veces consecutivas)
  "HealthMonitor": {
    // false → deshabilitar sin reiniciar (útil en mantenimientos programados)
    "Enabled": true,
    // Segundos entre ciclos de sondeo completos
    "IntervalSeconds": 60,
    // Segundos de espera al arrancar antes del primer sondeo (deja inicializar la app)
    "StartupDelaySeconds": 30,
    // Tiempo máximo para establecer conexión antes de contar como fallo
    "ProbeTimeoutSeconds": 5,
    // Latencia en ms a partir de la cual se clasifica como Degradado
    "DegradedLatencyMs": 300,
    // Fallos consecutivos necesarios para marcar Offline (evita alertas por fallos transitorios)
    "OfflineThreshold": 2,
    // Segundos entre reintentos para un CAD ya confirmado Offline (circuit-breaker)
    "OfflineBackoffSeconds": 120,
    // Máximo de CADs sondeados simultáneamente por ciclo
    "MaxParallelProbes": 8
  }
}
