# Base de datos maestra (PostgreSQL) — docker-compose.yml levanta un
# contenedor "postgres" propio y aislado (no comparte nada con otros
# proyectos del servidor) usando estas credenciales, y arma
# ConnectionStrings:MasterDb apuntando a ese contenedor automáticamente.
# El registro de tenants (secad_tenants) y el enrutamiento a la BD de cada
# CAD viven dentro de esta misma base.
POSTGRES_DB=Secad
POSTGRES_USER=secad_app
POSTGRES_PASSWORD=

# Postgres del tenant Cali — instancia separada de la maestra, con su propio
# volumen. Tras levantarla, se registra en SECAD desde Super Admin → Tenants
# con dbHost=postgres-cali, dbPort=5432 y estas mismas credenciales.
POSTGRES_CALI_DB=Secad_Cali
POSTGRES_CALI_USER=secad_cali_app
POSTGRES_CALI_PASSWORD=

# Postgres del tenant 11001 (CAD Bogotá D.C.) — instancia separada, con su
# propio volumen. Tras levantarla, se actualiza la fila existente en
# secad_tenants para que apunte a dbHost=postgres-bogota, dbPort=5432 y
# estas mismas credenciales (reemplazando el localhost:5433 heredado de un
# entorno de desarrollo que no existe en este servidor).
POSTGRES_BOGOTA_DB=Secad_Bogota
POSTGRES_BOGOTA_USER=secad_bogota_app
POSTGRES_BOGOTA_PASSWORD=

# Clave de firma JWT — reemplaza el placeholder de appsettings.json
# ("CAMBIAR_EN_PRODUCCION..."). Mínimo 32 caracteres aleatorios.
JWT_KEY=

# Clave que deben enviar los sistemas externos (PlantaTel/Chat/SMS) en la
# cabecera X-Api-Key hacia RecepcionExterna. Reemplaza el placeholder de
# appsettings.json. Mínimo 32 caracteres aleatorios.
RECEPCION_EXTERNA_API_KEY=

# Dominio público real de ESTE despliegue (con esquema, sin / final) — se usa
# para armar el link .../video/{token} que se envía al ciudadano en la
# videollamada. Debe ser accesible por HTTPS desde el navegador del ciudadano
# (getUserMedia exige contexto seguro). Ej: https://secad.midominio.com
SECAD_BASE_URL=https://secad.policia.gov.co

# Envío por SMS del link de videollamada (Infobip, opcional). Si se dejan
# vacías, el envío por SMS degrada solo (el despachador copia el link a mano),
# sin romper el flujo de la videollamada.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=

# Puertos publicados en el HOST (no dentro del contenedor) — cámbialos si en
# el servidor ya hay otro proyecto usando el 80 y/o el 8088.
FRONTEND_PORT=80
API_PORT=8088
