{
  "name": "policiadev-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:mfa": "ng build @policia/mfa",
    "pack:mfa": "ng build @policia/mfa && npm pack ./dist/policia-mfa",
    "publish:mfa": "ng build @policia/mfa && npm publish ./dist/policia-mfa",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:a11y": "powershell -ExecutionPolicy Bypass -File ./check-accessibility.ps1",
    "postinstall": "patch-package && node scripts/clean-zod-tests.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@microsoft/signalr": "^8.0.29",
    "@policia/mfa": "file:dist-libs/policia-mfa-1.0.0.tgz",
    "ngx-editor": "^19.0.0-beta.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.2",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "semver": "^7.7.2"
  }
}
